// surface_tests.nv — the rest of the published surface, called once
// each.
//
// `keydecode_tests.nv` asserts behaviour: that a lone ESC stays held,
// that a flush resolves it.  This one asserts that the surface is
// callable at all, which is that every published signature type-checks
// from outside its own module, with the argument types a consumer would
// pass.  A signature a consumer cannot call is a signature no behaviour
// test reaches, so it is worth a suite of its own.

use std.test
use std.list
use keymodel
use mousedecode
use keydecode
use keychunk

@test
fn test_the_three_keystroke_constructors_agree_with_the_model() [io]
    test.case("a character key has no modifiers")
    let q = keymodel.char_key(0x71)
    test.assert(keymodel.mods_any(q.mods) == false)

    test.case("a control key has ctrl and the letter")
    let c = keymodel.ctrl_key(0x63)
    test.assert(c.mods.ctrl)

    test.case("a named key is the name")
    let home = keymodel.named_key(keymodel.KEY_HOME)
    test.assert(home.press.kind == keymodel.KEY_PRESS_NAMED)
    test.assert(home.press.name == keymodel.KEY_HOME)

    test.case("and equal keystrokes compare equal")
    test.assert(keymodel.stroke_eq(q, keymodel.char_key(0x71)))
    test.assert(keymodel.stroke_eq(q, c) == false)

@test
fn test_modifiers_can_be_replaced_and_compared() [io]
    let plain = keymodel.no_mods()
    let ctrl = keymodel.mods_of(5)

    test.case("two modifier sets compare")
    test.assert(keymodel.mods_eq(plain, plain))
    test.assert(keymodel.mods_eq(plain, ctrl) == false)

    test.case("and a keystroke takes a new set")
    let k = keymodel.with_mods(keymodel.char_key(0x71), ctrl)
    test.assert(k.mods.ctrl)

@test
fn test_the_control_byte_mapping_runs_both_ways() [io]
    test.case("a letter has a control byte")
    test.assert(keymodel.control_char(0x63) == 0x03)

    test.case("and a digit does not")
    test.assert(keymodel.control_char(0x31) == keymodel.NO_CODEPOINT)

@test
fn test_a_function_key_carries_its_number() [io]
    test.case("F5 is a named key with a number beside the name")
    let f5 = keymodel.key_function(5)
    test.assert(f5.kind == keymodel.KEY_PRESS_NAMED)
    test.assert(f5.name == keymodel.KEY_FUNCTION)
    test.assert(f5.number == 5)

@test
fn test_the_keypad_keys_are_their_own_press() [io]
    test.case("a keypad digit is not the digit above the letters")
    let pad = keymodel.key_pad_digit(5)
    test.assert(pad.kind == keymodel.KEY_PRESS_PAD)
    test.assert(pad.pad == keymodel.KEYPAD_DIGIT)
    test.assert(pad.number == 5)
    test.assert(keymodel.press_eq(pad, keymodel.key_char(0x35)) == false)

    test.case("and keypad 5 with NumLock off has a name of its own")
    test.assert(keymodel.press_eq(keymodel.key_pad(keymodel.KEYPAD_BEGIN), pad)
                == false)

@test
fn test_the_button_byte_splits_into_button_modifiers_and_motion() [io]
    test.case("button 0 with no modifiers is the left button")
    test.assert(mousedecode.decode_button(0) == mousedecode.MOUSE_LEFT)
    test.assert(keymodel.mods_any(mousedecode.decode_mods(0)) == false)
    test.assert(mousedecode.is_motion(0) == false)

    test.case("bit 5 is motion")
    test.assert(mousedecode.is_motion(32))

    test.case("bit 6 puts the low bits into the wheel's meaning")
    test.assert(mousedecode.decode_button(64) == mousedecode.MOUSE_WHEEL_UP)
    test.assert(mousedecode.decode_button(65) == mousedecode.MOUSE_WHEEL_DOWN)

    test.case("and bit 7 puts them into buttons 8..11")
    test.assert(mousedecode.decode_button(128) == mousedecode.MOUSE_EXTRA_BUTTON)
    test.assert(mousedecode.decode_button_number(128) == 8)

@test
fn test_the_button_byte_can_be_written_as_well_as_read() [io]
    test.case("the round trip holds for a plain press")
    let code = mousedecode.button_code(mousedecode.MOUSE_LEFT, 0,
                                       keymodel.no_mods(), false)
    test.assert(mousedecode.decode_button(code) == mousedecode.MOUSE_LEFT)

    test.case("and for a wheel turn with ctrl held, which is a zoom in most programs")
    let wheel = mousedecode.button_code(mousedecode.MOUSE_WHEEL_UP, 0,
                                        keymodel.mods_of(5), false)
    test.assert(mousedecode.decode_mods(wheel).ctrl)

@test
fn test_all_three_encodings_produce_the_same_value() [io]
    test.case("X10's three raw bytes")
    let x10 = mousedecode.report_x10(0x20, 0x48, 0x2C)
    test.assert(x10.col == 40 and x10.row == 12)

    test.case("SGR's three parameters and its final byte")
    let sgr = mousedecode.report_sgr(0, 40, 12, 0x4D)
    test.assert(sgr.col == 40 and sgr.row == 12)

    test.case("and urxvt's, whose first parameter carries X10's offset")
    let urxvt = mousedecode.report_urxvt(32, 40, 12)
    test.assert(urxvt.col == 40 and urxvt.row == 12)

@test
fn test_only_the_sgr_encoding_knows_which_button_was_released() [io]
    test.case("SGR's lower-case final byte is a release of a named button")
    let sgr = mousedecode.report_sgr(0, 40, 12, 0x6D)
    test.assert(sgr.action == mousedecode.MOUSE_RELEASED)
    test.assert(sgr.button == mousedecode.MOUSE_LEFT)

    test.case("while X10's button 3 says a button was let go and not which")
    let x10 = mousedecode.report_x10(0x23, 0x48, 0x2C)
    test.assert(x10.action == mousedecode.MOUSE_RELEASED)
    test.assert(x10.button == mousedecode.MOUSE_NO_BUTTON)

@test
fn test_a_wheel_turn_answers_the_question_a_program_asks() [io]
    test.case("a wheel turn says so by name")
    test.assert(mousedecode.is_wheel(mousedecode.report_sgr(64, 10, 10, 0x4D)))

    test.case("and a button press does not")
    test.assert(mousedecode.is_wheel(mousedecode.report_sgr(0, 10, 10, 0x4D))
                == false)

@test
fn test_the_x10_ceiling_is_a_question_a_program_can_ask() [io]
    test.case("a coordinate below the ceiling is exact")
    test.assert(mousedecode.coordinates_are_exact(
        mousedecode.report_x10(0x20, 0x48, 0x2C)))

    test.case("a clamped one is not, and the value would be a lie")
    let clamped = mousedecode.report_x10(0x20, 0xFF, 0x2C)
    test.assert(clamped.col == mousedecode.X10_COORD_MAX)
    test.assert(mousedecode.coordinates_are_exact(clamped) == false)

    test.case("while SGR has no ceiling to hit")
    test.assert(mousedecode.coordinates_are_exact(
        mousedecode.report_sgr(0, 400, 12, 0x4D)))

@test
fn test_the_package_says_which_protocols_it_covers() [io]
    test.case("three are covered")
    test.assert(keydecode.protocol_supported(keydecode.KEY_LEGACY_FORMS))
    test.assert(keydecode.protocol_supported(keydecode.KEY_MODIFY_OTHER_KEYS))
    test.assert(keydecode.protocol_supported(keydecode.KEY_KITTY_KEYBOARD))

    test.case("and one is refused with a reason rather than a silence")
    test.assert(keydecode.protocol_supported(keydecode.KEY_WIN32_INPUT) == false)
    test.assert(str.len(keydecode.protocol_refusal(keydecode.KEY_WIN32_INPUT)) > 0)

    test.case("a covered protocol has no refusal")
    test.assert(str.len(keydecode.protocol_refusal(keydecode.KEY_LEGACY_FORMS)) == 0)

@test
fn test_the_two_limit_sets_differ_in_the_one_setting() [io]
    let full = keydecode.default_limits()
    let legacy = keydecode.legacy_limits()

    test.case("the default recognises the kitty forms")
    test.assert(full.kitty_enabled)

    test.case("and the legacy set does not")
    test.assert(legacy.kitty_enabled == false)

    test.case("while both bound one sequence the same way")
    test.assert(full.sequence_bytes_max == legacy.sequence_bytes_max)
    test.assert(full.sequence_bytes_max == keydecode.SEQUENCE_BYTES_CAP)

@test
fn test_a_complete_sequence_decodes_on_its_own() [io]
    // The entry point for a test with a fixture, and for a key binding
    // written in a configuration file as the bytes a terminal sends.
    test.case("a whole sequence gives an event")
    let up = keychunk.decode_one([0x1B as u8, 0x5B as u8, 0x41 as u8],
                                 keydecode.default_limits())
    test.assert(up.kind == keydecode.KEY_EVENT_PRESSED)
    test.assert(up.stroke.press.name == keymodel.KEY_UP)

    test.case("and a prefix gives nothing rather than a guess")
    test.assert(keychunk.decode_one([0x1B as u8, 0x5B as u8],
                                    keydecode.default_limits()).kind
                == keydecode.KEY_EVENT_NONE)

@test
fn test_an_event_can_be_built_as_well_as_read() [io]
    // A multiplexer forwarding input to a child, and a test feeding a
    // program a synthetic terminal, both write events rather than only
    // reading them.
    test.case("an event that carries a keystroke")
    let pressed = keydecode.pressed_event(keymodel.named_key(keymodel.KEY_END))
    test.assert(pressed.kind == keydecode.KEY_EVENT_PRESSED)
    test.assert(pressed.stroke.press.name == keymodel.KEY_END)

    test.case("an event that carries a mouse report")
    let clicked = keydecode.mouse_event(mousedecode.report_sgr(0, 5, 6, 'M'))
    test.assert(clicked.kind == keydecode.KEY_EVENT_MOUSE)
    test.assert(clicked.mouse.col == 5)

    test.case("an event that carries nothing")
    test.assert(keydecode.marker_event(keydecode.KEY_EVENT_FOCUS_LOST).kind
                == keydecode.KEY_EVENT_FOCUS_LOST)

    test.case("an event that carries one byte")
    let pasted = keydecode.byte_event(keydecode.KEY_EVENT_PASTE_BYTE, 0x41)
    test.assert(pasted.byte == 0x41)

    test.case("and the event of a step that completed none")
    test.assert(keydecode.no_event().kind == keydecode.KEY_EVENT_NONE)

@test
fn test_the_escape_timeout_is_advice_and_not_a_timer() [io]
    test.case("the package publishes a number a host can use")
    test.assert(keydecode.ESCAPE_TIMEOUT_MS == 25)

    test.case("and nothing in the package consults it, which is why a flush exists")
    let drained = keychunk.flush(keydecode.decoder_with(keydecode.default_limits()))
    test.assert(list.len(drained.events) == 0)
