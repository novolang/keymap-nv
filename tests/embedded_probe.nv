// embedded_probe.nv — this package's device claim, as a program that
// either builds for a Cortex-M or does not.
//
// It is not a test.  `scripts/shard_audit.sh`'s `core-embedded` row
// copies it and the modules it names into a package of its own and
// runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a real Cortex-M4 ELF or fails.
//
// WHY THE CLAIM IS WORTH MAKING HERE.  A device with a serial console
// takes keystrokes off a UART, and the bytes are the same bytes: an
// arrow key is `ESC [ A` on a Cortex-M as much as it is in a terminal
// emulator.  The lone-ESC problem is the same too, and its resolution
// is the reason the package fits a device at all — a firmware's read
// loop already has a timer, and `flush` is how it hands the answer
// back.
//
// WHAT THE TIER ACTUALLY CHECKS on an interface package is narrower
// than it will be on the implementation, and saying so is more useful
// than pretending otherwise: every body is a `todo()`, so what links
// today is the SIGNATURES and the types.  `KeyDecoder.held` is a
// `[u8]` and will have to become a fixed-capacity buffer —
// heapless-nv's — before any of it runs on a device.  That is a known
// cost of the implementation step, not a surprise waiting in it.

use keymodel
use mousedecode
use keydecode

// Every answer this probe checks, folded into one number so a single
// comparison decides the run.  A firmware image has one line of
// output; making it depend on all of them is what stops a passing run
// from meaning "the first call linked".
@tier(rt)
fn score() -> Int
    var n = 0
    // The decoder as a value, fed one byte, and the ambiguity it
    // leaves behind.
    let d = keydecode.decoder_with(keydecode.legacy_limits())
    let step = keydecode.feed_byte(d, 0x1B)
    match step.event
        None    =>
            n = n + 1
        Some(_) =>
            n = n + 2
    if keydecode.is_pending(step.decoder)
        n = n + 1
    if keydecode.pending_bytes(step.decoder) == 1
        n = n + 1
    if keydecode.in_paste(step.decoder) == false
        n = n + 1
    // The key model, which is what a firmware's key table is written
    // against.
    let up = keymodel.named_key(KeyUp)
    if keymodel.stroke_eq(up, keymodel.named_key(KeyUp))
        n = n + 1
    if keymodel.mods_param(keymodel.no_mods()) == 1
        n = n + 1
    match keymodel.char_of_control(0x03)
        Some(c) =>
            if c == 0x63
                n = n + 1
        None    =>
            n = n + 0
    // The mouse byte table, which is arithmetic and nothing else.
    if mousedecode.is_motion(32)
        n = n + 1
    if mousedecode.button_code(MouseLeft, keymodel.no_mods(), false) == 0
        n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // 9 is the number of checks in `score` on the path a linked build
    // takes.  The count is printed on a failure rather than only
    // compared, so a device that disagrees with the host says HOW MANY
    // it lost and a bisect has somewhere to start.
    let n = score()
    if n == 9
        hal.uart.write("PASS: keymap-embedded\n")
    else
        hal.uart.write("FAIL: keymap-embedded\n")
    loop
        core.rt.sleep_ms(1000)
