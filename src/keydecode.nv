// keydecode.nv — bytes in, key and mouse events out, and the one
// question a decoder cannot answer on its own.
//
// A byte 0x1B arrives.  It is either the Escape key, or the first byte
// of an arrow key, or the first byte of Alt and a letter, and nothing
// in the byte stream distinguishes them.  What distinguishes them is
// time: a byte that arrives within a few milliseconds belongs to a
// sequence, and one that does not means the user pressed Escape.  Every
// terminal program resolves this with a timeout, and every one of them
// puts the timeout somewhere different.
//
// A `core` package has no clock, which turns out to be the right
// constraint rather than an obstacle.  This decoder times nothing.  It
// holds the ambiguous bytes, reports that it is holding them, and
// resolves them when the host, whose read timed out, calls `flush`.
// The timeout lives where the reading lives, and the decoding lives
// here.
//
// Three protocols are read at once, and a fourth is refused:
//
//   legacy            the classic forms, which are the C0 bytes,
//                     `ESC [ A`, `ESC O P`, `ESC [ 1 5 ~` and
//                     `ESC [ 1 ; 5 A`.
//   modifyOtherKeys   xterm's `CSI 27 ; <mods> ; <codepoint> ~`, which
//                     is how Ctrl and Shift and a letter becomes
//                     sayable.
//   kitty keyboard    `CSI <codepoint> ; <mods> : <event> u` and the
//                     named-key forms, with press, repeat and release.
//
//   win32-input-mode  not read.  `protocol_refusal` says why.  Its six
//                     parameters describe a Windows console
//                     KEY_EVENT_RECORD, with a virtual key code and a
//                     scan code, and mapping those onto this model
//                     needs a Windows keyboard-layout table that is not
//                     arithmetic.
//
// Which protocol is in use is not a setting.  All three are read at
// once, because their sequences do not collide and a decoder that had
// to be told would be wrong every time the negotiation was.  What is a
// setting is whether the kitty forms are read at all, for a program
// running against a terminal it has not negotiated with.
//
// The state is the bytes themselves.  `held` carries the sequence in
// progress, and every byte re-reads it from the start, which is what
// lets one buffer serve a sequence, a partly arrived codepoint and the
// end marker of a paste.  A sequence is at most `sequence_bytes_max`
// bytes long, so the work per byte is bounded by that number.

use std.list
use keymodel
use mousedecode

// KeyProtocol names an input protocol, so that a program can ask what
// this package reads before it asks a terminal to speak it.
pub enum KeyProtocol
    KeyLegacyForms
    KeyModifyOtherKeys
    KeyKittyKeyboard
    KeyWin32Input

// protocol_supported says whether this package decodes a protocol.
pub fn protocol_supported(p: KeyProtocol) -> Bool
    match p
        KeyWin32Input => false
        _             => true

// protocol_refusal is why a protocol is not read, or `None` when it is.
//
// A refusal with a reason rather than an absence, because whether this
// package reads win32-input-mode is a question a reader will ask, and
// the answer is more useful than the silence.
pub fn protocol_refusal(p: KeyProtocol) -> ?Str
    match p
        KeyWin32Input => Some("win32-input-mode carries a Windows console KEY_EVENT_RECORD, whose virtual key code and scan code need a Windows keyboard-layout table to become a key")
        _             => None

// KeyLimits is the ceiling on what the decoder will hold.
//
// A decoder with no ceiling is one a hostile stream can grow without
// bound.  An escape sequence of a million digits is such a stream, and
// the bound on it is the caller's.  A bracketed paste needs no bound,
// because its bytes are reported as they arrive and none of them is
// kept.
pub struct KeyLimits
    // Bytes of one escape sequence held before the decoder gives up on
    // it and reports `KeyUnknownSequence`.
    sequence_bytes_max: Int
    // Whether the kitty forms are read.  A program that has not
    // negotiated the protocol may still want them off, because a
    // terminal that never sends them cannot be told apart from one that
    // does by anything but the negotiation.
    kitty_enabled: Bool

// KeyDecoder is the input state machine: what it is holding, and how
// much of it.
//
// A value, like ansi-nv's parser and for the same reason.  `feed_byte`
// takes one and returns one, so a caller may keep the decoder an event
// came out of.
pub struct KeyDecoder
    limits: KeyLimits
    // The bytes of a sequence in progress, of a codepoint in progress,
    // or of a paste's end marker in progress.  Empty when the decoder
    // is settled.
    held: [u8]
    // Whether a bracketed paste is open.  Kept apart from `held`
    // because a paste's bytes are reported as they arrive rather than
    // accumulated, so during one the decoder holds at most the five
    // bytes of a half-arrived end marker.
    in_paste: Bool

// KeyEvent is one thing that happened at the terminal.
pub enum KeyEvent
    KeyPressed(stroke: keymodel.KeyStroke)
    KeyMouse(report: mousedecode.MouseReport)
    // A bracketed paste is starting.  Everything until `KeyPasteEnd` is
    // pasted text and not typing, which is the distinction an editor
    // needs and the reason the mode exists.
    KeyPasteStart
    // One byte of pasted text.  A byte at a time rather than a string
    // at the end, so that a paste of any size costs the decoder nothing
    // to carry and a program can stream it into a buffer of its own.
    KeyPasteByte(byte: Int)
    KeyPasteEnd
    // The terminal window gained focus, which is DEC mode 1004 and
    // `CSI I`.
    KeyFocusGained
    // The terminal window lost focus, which is `CSI O`.
    KeyFocusLost
    // A sequence this package read the shape of and not the meaning,
    // which is a CSI with a final byte nothing here claims.  Reported
    // rather than dropped, because a program that knows about a
    // sequence this package does not, such as a terminal's own
    // extension or a query reply it asked for, has to be able to see
    // it.
    KeyUnknownSequence(final_byte: Int)

// KeyStep is one byte's worth of progress.
pub struct KeyStep
    decoder: KeyDecoder
    // The event the byte completed, if it completed one.  Most bytes of
    // a sequence complete nothing.
    event: ?KeyEvent

// KeyDrained is a chunk's or a flush's worth of events, and the decoder
// left over.
//
// `flush` returns a list rather than one event because resolving a held
// sequence can produce several.  An `ESC [` that never finished is the
// Escape key, then `[`.
pub struct KeyDrained
    decoder: KeyDecoder
    events: [KeyEvent]

// How long a host should wait for the byte after a lone ESC before
// calling `flush`, in milliseconds.
//
// A number, not a timer: this package cannot wait and does not try to.
// 25 is what vim, tmux and crossterm converge on.  It is long enough
// that a sequence arriving over a slow link is not split, and short
// enough that pressing Escape does not feel stuck.  A host on a
// high-latency link wants more and should say so.
pub const ESCAPE_TIMEOUT_MS = 25

// The bytes a sequence is built from.
const ESC = 0x1B
const CSI_OPEN = '['
const SS3_OPEN = 'O'

// The parameter number of a slot the sequence left empty, as in the two
// of `CSI ; ; H`.  Absent and zero stay different answers.
const PARAM_EMPTY = 0 - 1

// The largest value one parameter may hold, which is xterm's ceiling.
// Every number any form here reads is far below it, and a parameter
// that reaches it stops rather than wrapping.
const PARAM_MAX = 65535

// The parameter of `CSI 200 ~`, which opens a bracketed paste, and of
// `CSI 201 ~`, which closes one.
const PASTE_START_PARAM = 200
const PASTE_END_PARAM = 201

// The parameter of xterm's modifyOtherKeys form, `CSI 27 ; <mods> ;
// <codepoint> ~`.
const MODIFY_OTHER_PARAM = 27

// The kitty protocol's event types, which are the second entry of the
// modifier group: 1 is a press, 2 a repeat and 3 a release.
const KITTY_REPEAT = 2
const KITTY_RELEASE = 3

// Where the kitty protocol's functional keys live, which is the Unicode
// private use area from 57344 upwards.
const KITTY_FUNCTIONAL = 57344

// default_limits allows 64 bytes of one sequence and reads the kitty
// forms.
pub fn default_limits() -> KeyLimits
    KeyLimits { sequence_bytes_max: 64, kitty_enabled: true }

// legacy_limits allows 64 bytes of one sequence and does not read the
// kitty forms.
pub fn legacy_limits() -> KeyLimits
    KeyLimits { sequence_bytes_max: 64, kitty_enabled: false }

// decoder_new is a settled decoder with `default_limits`.
pub fn decoder_new() -> KeyDecoder
    decoder_with(default_limits())

// decoder_with is a settled decoder with the limits given.
pub fn decoder_with(limits: KeyLimits) -> KeyDecoder
    KeyDecoder { limits: limits, held: [], in_paste: false }

// feed_byte advances the decoder by one byte.
//
// The entry point everything else is written over.  Most bytes of a
// sequence complete nothing and come back with `event: None`, and the
// byte that finishes one comes back with the event.
//
// A lone ESC is never reported as the Escape key here, however long ago
// it arrived, because this function has no idea how long ago that was.
// It leaves the decoder pending, and `flush` is what resolves it.
//
// ```novo
// use keydecode
//
// fn main() [io]
//     let d = keydecode.decoder_new()
//     let step = keydecode.feed_byte(d, 0x1B)
//     match step.event
//         None    => println("held — could be Escape, could be an arrow")
//         Some(_) => println("an event, which a lone ESC never is")
// ```
pub fn feed_byte(d: KeyDecoder, b: Int) -> KeyStep
    if d.in_paste
        paste_byte(d, b)
    else if list.len(d.held) == 0
        first_byte(d, b)
    else
        next_byte(d, b)

// feed advances the decoder over a whole chunk.
//
// The convenience over `feed_byte`, and the one most hosts will use.  A
// read gives a chunk, the chunk gives events, and whatever is left over
// stays held for the next read, or for the `flush` after the read that
// times out.
pub fn feed(d: KeyDecoder, chunk: [u8]) -> KeyDrained
    var q = d
    var events: [KeyEvent] = []
    for b in chunk
        let s = feed_byte(q, b as Int)
        q = s.decoder
        events = with_event(events, s.event)
    KeyDrained { decoder: q, events: events }

// flush resolves whatever the decoder is holding, on the caller's word
// that no more bytes are coming.
//
// A host reads with a timeout.  When the read times out and the decoder
// is pending, it calls this, and the held bytes become events: a lone
// ESC becomes the Escape key, an `ESC [` that never finished becomes
// Escape and then `[`, and a half-arrived codepoint becomes one
// character per byte.
//
// Calling it on a settled decoder produces no events and is harmless,
// so a host may call it after every timed-out read without checking.
//
// ```novo
// use std.list
// use keydecode
//
// fn main() [io]
//     var d = keydecode.decoder_new()
//     let step = keydecode.feed_byte(d, 0x1B)
//     d = step.decoder
//     // …the host's read times out here, and only the host knows it.
//     let drained = keydecode.flush(d)
//     match list.get(drained.events, 0)
//         KeyPressed(_) => println("Escape, resolved by the caller's clock")
//         _             => println("something else")
// ```
pub fn flush(d: KeyDecoder) -> KeyDrained
    if list.len(d.held) == 0
        return KeyDrained { decoder: d, events: [] }
    if d.in_paste
        return KeyDrained { decoder: settled(d), events: paste_bytes(d.held) }
    // The first held byte is the ESC that was never resolved, or the
    // lead of a codepoint that never arrived.  Either way it is now a
    // key of its own, and the bytes behind it are read again from a
    // settled decoder, which is what makes `ESC [` two events rather
    // than one.
    let first = byte_at(d.held, 0)
    let head = if first == ESC
        KeyPressed(keymodel.named_key(KeyEscape))
    else
        KeyPressed(keymodel.char_key(first))
    let again = feed(settled(d), list.slice(d.held, 1, list.len(d.held)))
    let rest = flush(again.decoder)
    KeyDrained { decoder: rest.decoder,
                 events: list.concat(list.concat([head], again.events), rest.events) }

// is_pending says whether the decoder is holding bytes it cannot
// resolve without either another byte or a `flush`.
//
// What a host's read loop switches on.  Pending means read with the
// escape timeout, and settled means block.  A host that always used a
// timeout would spin, and one that always blocked would leave the
// Escape key stuck until the next keystroke, which is the bug every
// terminal program has shipped at least once.
pub fn is_pending(d: KeyDecoder) -> Bool
    list.len(d.held) > 0

// pending_bytes is how many bytes the decoder is holding.
//
// For a host that logs, and for a test that wants to assert a chunk
// boundary left exactly what it should have.
pub fn pending_bytes(d: KeyDecoder) -> Int
    list.len(d.held)

// in_paste says whether a bracketed paste is open.
//
// Not the same question as `is_pending`.  During a paste every byte is
// reported as it arrives, so the decoder is usually holding nothing and
// is still not settled, because the paste has to end before anything
// after it can be read as typing.
pub fn in_paste(d: KeyDecoder) -> Bool
    d.in_paste

// reset drops whatever the decoder is holding and closes any open
// paste.
//
// What a program calls when it has taken the terminal back from a
// child, or after an error where the held bytes are known to be stale.
pub fn reset(d: KeyDecoder) -> KeyDecoder
    decoder_with(d.limits)

// decode_one is the whole decoder over a complete sequence, for a
// caller that already has one.
//
// `None` when the bytes are not one complete sequence, which is a
// prefix, an empty list, something this package does not read, or two
// sequences at once.  It exists for the two callers that are not read
// loops: a test with a fixture, and a program with a key binding
// written as the bytes a terminal sends, which is how a configuration
// file spells one.
pub fn decode_one(sequence: [u8], limits: KeyLimits) -> ?KeyEvent
    let out = feed(decoder_with(limits), sequence)
    if list.len(out.events) == 1 and is_pending(out.decoder) == false
        Some(list.get(out.events, 0))
    else
        None

// ── the machinery behind the surface ────────────────────────────────
//
// Nothing below is `pub`.  Each step builds a fresh `KeyDecoder` rather
// than assigning a field of a copy, so the decoder a caller kept is
// never written through.

// One byte of a list, as the number the rest of the module works in.
fn byte_at(h: [u8], i: Int) -> Int
    list.get(h, i) as Int

// The decoder with nothing held, keeping its limits and its paste.
fn settled(d: KeyDecoder) -> KeyDecoder
    KeyDecoder { limits: d.limits, held: [], in_paste: d.in_paste }

// The step that holds `held` and reports nothing.
fn holding(d: KeyDecoder, held: [u8]) -> KeyStep
    KeyStep { decoder: KeyDecoder { limits: d.limits, held: held,
                                    in_paste: d.in_paste },
              event: None }

// The step that reports one event, holds nothing, and says whether a
// paste is open afterwards.
fn reporting(d: KeyDecoder, e: KeyEvent, paste: Bool) -> KeyStep
    KeyStep { decoder: KeyDecoder { limits: d.limits, held: [], in_paste: paste },
              event: Some(e) }

// The accumulator `feed` adds a step's event to.
fn with_event(events: [KeyEvent], e: ?KeyEvent) -> [KeyEvent]
    match e
        Some(v) => list.push(events, v)
        None    => events

// Every byte of a list, as one paste byte each.
//
// A fold rather than `list.map`, which on this toolchain strands one
// box per element when the lambda builds an enum variant (novo bug
// memory-perceus/list-map-leaks-a-box-per-element-when-the-lambda-builds-an-enum-variant).
fn paste_bytes(h: [u8]) -> [KeyEvent]
    list.fold(h, (events, b) => list.push(events, KeyPasteByte(b as Int)), [])

// ── the ground state ────────────────────────────────────────────────

// The first byte of whatever comes next.
//
// ESC opens a sequence and is held, and a byte at 0xC2 or above opens a
// codepoint and is held with it.  Everything else is a key on its own.
fn first_byte(d: KeyDecoder, b: Int) -> KeyStep
    if b == ESC or utf8_owed(b) > 0
        holding(d, [b as u8])
    else
        reporting(d, ground_key(b, keymodel.no_mods()), false)

// The key a byte below 0x80 stands for, with the modifiers already
// read off the sequence that carried it.
//
// Tab, Enter and Backspace are keys rather than the control characters
// they share a byte with.  Every other byte below 0x20 is its letter
// with ctrl held, which is what `keymodel.char_of_control` answers, and
// a byte from 0x20 up is the character itself.
fn ground_key(b: Int, m: keymodel.KeyMods) -> KeyEvent
    if b == 0x09
        named_with(KeyTab, m)
    else if b == 0x0D
        named_with(KeyEnter, m)
    else if b == 0x7F
        named_with(KeyBackspace, m)
    else if b < 0x20
        KeyPressed(KeyStroke { press: KeyChar(keymodel.char_of_control(b) ?? b),
                               mods: with_ctrl(m), motion: KeyDownEvent })
    else
        char_with(b, m)

// A named key with the modifiers given.
fn named_with(name: keymodel.KeyName, m: keymodel.KeyMods) -> KeyEvent
    KeyPressed(KeyStroke { press: KeyNamed(name), mods: m, motion: KeyDownEvent })

// A character with the modifiers given.
fn char_with(codepoint: Int, m: keymodel.KeyMods) -> KeyEvent
    KeyPressed(KeyStroke { press: KeyChar(codepoint), mods: m, motion: KeyDownEvent })

// The same modifier set with ctrl held.
fn with_ctrl(m: keymodel.KeyMods) -> keymodel.KeyMods
    KeyMods { shift: m.shift, alt: m.alt, ctrl: true, meta: m.meta }

// The modifier parameter of a sequence, with the alt an ESC prefix
// added.
fn mods_with(param: Int, alt: Bool) -> keymodel.KeyMods
    let m = keymodel.mods_of(param)
    if alt
        KeyMods { shift: m.shift, alt: true, ctrl: m.ctrl, meta: m.meta }
    else
        m

// ── the bytes of a sequence ─────────────────────────────────────────

// KeyScan is how far the held bytes have got.
enum KeyScan
    // The bytes so far are the start of something, and another byte
    // decides what.
    KeyScanMore
    // The bytes are one complete thing.
    KeyScanDone(event: KeyEvent)

// A byte that is not the first of what the decoder is holding.
//
// The whole held buffer is read again from the start, and the answer is
// either that it is still a prefix or that it is complete.  A sequence
// longer than the caller's ceiling is reported as unrecognised and
// dropped, which is what keeps a stream of digits from growing the
// decoder without bound.
fn next_byte(d: KeyDecoder, b: Int) -> KeyStep
    let h = list.push(d.held, b as u8)
    if list.len(h) > d.limits.sequence_bytes_max
        return reporting(d, KeyUnknownSequence(b), false)
    match scan(h, d.limits)
        KeyScanMore    => holding(d, h)
        KeyScanDone(e) => reporting(d, e, is_paste_start(e))

// Whether an event opens a bracketed paste.
fn is_paste_start(e: KeyEvent) -> Bool
    match e
        KeyPasteStart => true
        _             => false

// The held bytes, read from the start.
fn scan(h: [u8], limits: KeyLimits) -> KeyScan
    if byte_at(h, 0) == ESC
        scan_esc(h, 0, false, limits)
    else
        scan_utf8(h, 0, keymodel.no_mods())

// An ESC at `i`, and whatever follows it.
//
// An ESC in front of a character is the alt prefix, which is how a
// terminal spells Alt and a letter.  An ESC in front of a sequence is
// the alt prefix of that sequence, so `alt` carries down to the CSI and
// the SS3 forms and `ESC ESC [ A` is Alt and the up arrow.
fn scan_esc(h: [u8], i: Int, alt: Bool, limits: KeyLimits) -> KeyScan
    if i + 1 >= list.len(h)
        return KeyScanMore
    let b = byte_at(h, i + 1)
    if b == ESC
        scan_esc(h, i + 1, true, limits)
    else if b == CSI_OPEN
        scan_csi(h, i + 2, alt, limits)
    else if b == SS3_OPEN
        scan_ss3(h, i + 2, alt)
    else if utf8_owed(b) > 0
        scan_utf8(h, i + 1, mods_with(1, true))
    else
        KeyScanDone(ground_key(b, mods_with(1, true)))

// ── UTF-8 ───────────────────────────────────────────────────────────
//
// A terminal sends a character the keyboard produced as UTF-8, so the
// bytes of one codepoint arrive the way the bytes of a sequence do and
// are held the same way.

// How many continuation bytes a lead byte promises, or 0 for a byte
// that leads nothing.  0xC0, 0xC1 and 0xF5 upwards lead no codepoint
// any encoder produces, so they are characters of their own.
fn utf8_owed(lead: Int) -> Int
    if lead >= 0xC2 and lead <= 0xDF
        1
    else if lead >= 0xE0 and lead <= 0xEF
        2
    else if lead >= 0xF0 and lead <= 0xF4
        3
    else
        0

// The bits a lead byte contributes to the codepoint.
fn utf8_head(lead: Int, owed: Int) -> Int
    if owed == 1
        lead - 0xC0
    else if owed == 2
        lead - 0xE0
    else
        lead - 0xF0

// A codepoint at `i`, assembled from the lead byte and the number of
// continuation bytes it promises.
//
// The byte at `i` leads a codepoint, which every caller has already
// found; a byte that leads none is a character of its own and never
// arrives here.
//
// The continuation bytes are taken as they come.  A terminal that sends
// a byte outside 0x80 to 0xBF there has sent a codepoint no encoder
// produces, and the character it decodes to is as good an answer as
// any; checking would cost the decoder the ability to report the bytes
// it had already taken.
fn scan_utf8(h: [u8], i: Int, m: keymodel.KeyMods) -> KeyScan
    let lead = byte_at(h, i)
    let owed = utf8_owed(lead)
    if i + owed >= list.len(h)
        return KeyScanMore
    var v = utf8_head(lead, owed)
    for k in 1..owed + 1
        v = v * 64 + (byte_at(h, i + k) & 0x3F)
    KeyScanDone(char_with(v, m))

// ── SS3, which is `ESC O` and one byte ──────────────────────────────

// The key `ESC O <byte>` stands for.
//
// The four function keys, the four arrows, Home and End, and the keypad
// as a VT100 sends it in application mode.
fn scan_ss3(h: [u8], i: Int, alt: Bool) -> KeyScan
    if i >= list.len(h)
        return KeyScanMore
    let b = byte_at(h, i)
    let m = mods_with(1, alt)
    match ss3_key(b)
        Some(press) => KeyScanDone(KeyPressed(KeyStroke { press: press, mods: m,
                                                          motion: KeyDownEvent }))
        None        => KeyScanDone(KeyUnknownSequence(b))

// The press `ESC O <byte>` names, or `None` for a byte that names none.
fn ss3_key(b: Int) -> ?keymodel.KeyPress
    if b >= 'P' and b <= 'S'
        Some(KeyNamed(KeyFunction(1 + b - 'P')))
    else if b >= 'A' and b <= 'D'
        Some(KeyNamed(arrow_of(b)))
    else if b == 'H'
        Some(KeyNamed(KeyHome))
    else if b == 'F'
        Some(KeyNamed(KeyEnd))
    else if b == 'E'
        Some(KeyPad(KeyPadBegin))
    else if b == 'M'
        Some(KeyPad(KeyPadEnter))
    else if b == 'X'
        Some(KeyPad(KeyPadEqual))
    else if b >= 'p' and b <= 'y'
        Some(KeyPad(KeyPadDigit(b - 'p')))
    else
        pad_operator(b)

// The keypad operators a VT100 sends in application mode, which are the
// four arithmetic keys and the decimal point.
fn pad_operator(b: Int) -> ?keymodel.KeyPress
    if b == 'j'
        Some(KeyPad(KeyPadStar))
    else if b == 'k'
        Some(KeyPad(KeyPadPlus))
    else if b == 'm'
        Some(KeyPad(KeyPadMinus))
    else if b == 'n'
        Some(KeyPad(KeyPadDot))
    else if b == 'o'
        Some(KeyPad(KeyPadSlash))
    else
        None

// The arrow `A` to `D` names.
fn arrow_of(b: Int) -> keymodel.KeyName
    if b == 'A'
        KeyUp
    else if b == 'B'
        KeyDown
    else if b == 'C'
        KeyRight
    else
        KeyLeft

// ── CSI ─────────────────────────────────────────────────────────────

// KeyCsi is a control sequence read as far as the bytes allow: its
// parameters, the private marker it opened with, and the final byte
// that ended it.
//
// The parameters are a flat list and a group number each, exactly as
// ansi-nv's parser keeps them.  Colon-separated entries share a group
// and semicolon-separated ones do not, so `99 ; 1 : 3` is groups
// `0 1 1`.  A nested list per sequence would be an allocation per
// keystroke.
struct KeyCsi
    values: [Int]
    groups: [Int]
    private: Int
    final_byte: Int
    complete: Bool

// The body of a CSI at `i`, which is everything after `ESC [`.
//
// `CSI M` is read before this and never reaches it, because the X10
// mouse encoding puts three raw bytes after the final byte and a
// parameter scanner would read a coordinate of 59 as a separator.
fn scan_csi(h: [u8], i: Int, alt: Bool, limits: KeyLimits) -> KeyScan
    let n = list.len(h)
    if i >= n
        return KeyScanMore
    if byte_at(h, i) == 'M'
        return scan_x10(h, i + 1)
    let c = read_csi(h, i)
    if c.complete == false
        return KeyScanMore
    KeyScanDone(csi_event(c, alt, limits))

// The three raw bytes of an X10 mouse report, which follow `CSI M`.
fn scan_x10(h: [u8], i: Int) -> KeyScan
    if i + 2 >= list.len(h)
        return KeyScanMore
    match mousedecode.report_x10(byte_at(h, i), byte_at(h, i + 1), byte_at(h, i + 2))
        Some(r) => KeyScanDone(KeyMouse(r))
        None    => KeyScanDone(KeyUnknownSequence('M'))

// The parameters, the private marker and the final byte of a CSI.
//
// A byte that is none of those is collected and ignored, which is what
// an intermediate byte is: the sequence still ends at its final byte,
// and a form this package does not claim is reported by that byte.
fn read_csi(h: [u8], i: Int) -> KeyCsi
    let n = list.len(h)
    var values: [Int] = []
    var groups: [Int] = []
    var private = 0
    var start = i
    if byte_at(h, i) >= '<' and byte_at(h, i) <= '?'
        private = byte_at(h, i)
        start = i + 1
    for k in start..n
        let b = byte_at(h, k)
        if b >= '0' and b <= '9'
            let opened = open_slot(values, groups)
            values = opened.values
            groups = opened.groups
            values = with_digit(values, b - '0')
        else if b == ';'
            let opened = open_slot(values, groups)
            values = list.push(opened.values, PARAM_EMPTY)
            groups = list.push(opened.groups, next_group(opened.groups))
        else if b == ':'
            let opened = open_slot(values, groups)
            values = list.push(opened.values, PARAM_EMPTY)
            groups = list.push(opened.groups, last_group(opened.groups))
        else if b >= '@' and b <= '~'
            return KeyCsi { values: values, groups: groups, private: private,
                            final_byte: b, complete: true }
    KeyCsi { values: values, groups: groups, private: private, final_byte: 0,
             complete: false }

// KeySlots is a parameter list part-way through being read.
struct KeySlots
    values: [Int]
    groups: [Int]

// The parameter list with a slot open to write into.
//
// A separator that arrives before any digit opens the slot it
// terminated, which is what keeps the first parameter of `CSI ; 5 H` an
// absence rather than a zero.
fn open_slot(values: [Int], groups: [Int]) -> KeySlots
    if list.len(values) > 0
        KeySlots { values: values, groups: groups }
    else
        KeySlots { values: list.push(values, PARAM_EMPTY),
                   groups: list.push(groups, 0) }

// One more digit on the last slot of the list.
//
// A parameter stops growing at `PARAM_MAX`.  A sequence carrying a
// longer run of digits names no key, and the number it stops at is one
// no form here claims, so the sequence is reported by its final byte.
fn with_digit(values: [Int], d: Int) -> [Int]
    let last = list.get(values, list.len(values) - 1)
    let v = if last == PARAM_EMPTY
        d
    else if last > PARAM_MAX
        last
    else
        last * 10 + d
    list.push(list.slice(values, 0, list.len(values) - 1), v)

// The group the last slot belongs to.
fn last_group(groups: [Int]) -> Int
    list.get(groups, list.len(groups) - 1)

// The group a semicolon opens, which is the one after the last.
fn next_group(groups: [Int]) -> Int
    last_group(groups) + 1

// Where group `g` starts in the flat list, or -1 when the sequence has
// no such group.
fn group_start(groups: [Int], g: Int) -> Int
    for k in 0..list.len(groups)
        if list.get(groups, k) == g
            return k
    0 - 1

// How many groups a parameter list has.
fn group_count(c: KeyCsi) -> Int
    if list.len(c.groups) == 0
        0
    else
        last_group(c.groups) + 1

// Entry `sub` of group `g`, or `fallback` where the sequence left it
// out.
fn param(c: KeyCsi, g: Int, sub: Int, fallback: Int) -> Int
    let start = group_start(c.groups, g)
    if start < 0
        return fallback
    let i = start + sub
    if i >= list.len(c.groups) or (list.get(c.groups, i) == g) == false
        return fallback
    let v = list.get(c.values, i)
    if v == PARAM_EMPTY
        fallback
    else
        v

// The event a complete CSI describes.
fn csi_event(c: KeyCsi, alt: Bool, limits: KeyLimits) -> KeyEvent
    let f = c.final_byte
    if c.private == '<'
        sgr_mouse(c, f)
    else if f == 'M' and group_count(c) >= 3
        urxvt_mouse(c)
    else if f == 'u'
        kitty_event(c, alt, limits)
    else if f == '~'
        tilde_event(c, alt)
    else if f == 'I'
        KeyFocusGained
    else if f == 'O'
        KeyFocusLost
    else
        csi_key(c, f, alt)

// The mouse report of an SGR sequence, `CSI < <button> ; <col> ; <row>`
// and a final byte that says press or release.
fn sgr_mouse(c: KeyCsi, f: Int) -> KeyEvent
    match mousedecode.report_sgr(param(c, 0, 0, 0), param(c, 1, 0, 0),
                                 param(c, 2, 0, 0), f)
        Some(r) => KeyMouse(r)
        None    => KeyUnknownSequence(f)

// The mouse report of an urxvt sequence, whose first parameter carries
// the offset X10 adds.
fn urxvt_mouse(c: KeyCsi) -> KeyEvent
    match mousedecode.report_urxvt(param(c, 0, 0, 0), param(c, 1, 0, 0),
                                   param(c, 2, 0, 0))
        Some(r) => KeyMouse(r)
        None    => KeyUnknownSequence('M')

// The key a CSI ending in a letter names.
//
// `CSI A` and `CSI 1 ; 5 A` are the same key, with the modifier
// parameter in the second group.  `CSI R` is not a key: it is the reply
// to a cursor position query, and this package reports it as
// unrecognised so that the program which asked can read it.
fn csi_key(c: KeyCsi, f: Int, alt: Bool) -> KeyEvent
    let m = mods_with(param(c, 1, 0, 1), alt)
    let motion = kitty_motion(param(c, 1, 1, 1))
    match csi_press(f)
        Some(press) => KeyPressed(KeyStroke { press: press, mods: m, motion: motion })
        None        => KeyUnknownSequence(f)

// The press a CSI's final byte names, or `None` for a byte that names
// no key.
fn csi_press(f: Int) -> ?keymodel.KeyPress
    if f >= 'A' and f <= 'D'
        Some(KeyNamed(arrow_of(f)))
    else if f == 'H'
        Some(KeyNamed(KeyHome))
    else if f == 'F'
        Some(KeyNamed(KeyEnd))
    else if f == 'E'
        Some(KeyPad(KeyPadBegin))
    else if f == 'Z'
        Some(KeyNamed(KeyBackTab))
    else if f == 'P' or f == 'Q'
        Some(KeyNamed(KeyFunction(1 + f - 'P')))
    else if f == 'S'
        Some(KeyNamed(KeyFunction(4)))
    else
        None

// The event a CSI ending in `~` describes.
//
// The number in the first parameter is the key, and 200 and 201 are the
// two ends of a bracketed paste rather than keys.  27 is xterm's
// modifyOtherKeys form, where the modifiers are the second parameter
// and the codepoint is the third.
fn tilde_event(c: KeyCsi, alt: Bool) -> KeyEvent
    let n = param(c, 0, 0, 0)
    if n == PASTE_START_PARAM
        KeyPasteStart
    else if n == PASTE_END_PARAM
        KeyPasteEnd
    else if n == MODIFY_OTHER_PARAM
        ground_key(param(c, 2, 0, 0), mods_with(param(c, 1, 0, 1), alt))
    else
        tilde_key(c, n, alt)

// The named key a tilde number stands for, from xterm's `ctlseqs`,
// "PC-Style Function Keys".
fn tilde_event_name(n: Int) -> ?keymodel.KeyName
    if n == 1 or n == 7
        Some(KeyHome)
    else if n == 2
        Some(KeyInsert)
    else if n == 3
        Some(KeyDelete)
    else if n == 4 or n == 8
        Some(KeyEnd)
    else if n == 5
        Some(KeyPageUp)
    else if n == 6
        Some(KeyPageDown)
    else
        tilde_function(n)

// The function key a tilde number stands for.  The numbers run in five
// runs with gaps between them, because the terminals that defined them
// left room each time.
fn tilde_function(n: Int) -> ?keymodel.KeyName
    if n >= 11 and n <= 15
        Some(KeyFunction(n - 10))
    else if n >= 17 and n <= 21
        Some(KeyFunction(n - 11))
    else if n >= 23 and n <= 26
        Some(KeyFunction(n - 12))
    else if n >= 28 and n <= 29
        Some(KeyFunction(n - 13))
    else if n >= 31 and n <= 34
        Some(KeyFunction(n - 14))
    else
        None

// One tilde form, with its modifier parameter.
fn tilde_key(c: KeyCsi, n: Int, alt: Bool) -> KeyEvent
    match tilde_event_name(n)
        Some(name) => KeyPressed(KeyStroke { press: KeyNamed(name),
                                             mods: mods_with(param(c, 1, 0, 1), alt),
                                             motion: kitty_motion(param(c, 1, 1, 1)) })
        None       => KeyUnknownSequence('~')

// ── the kitty keyboard protocol ─────────────────────────────────────

// The event a `CSI <codepoint> ; <mods> : <event> u` sequence
// describes, or an unrecognised sequence when the caller turned the
// kitty forms off.
fn kitty_event(c: KeyCsi, alt: Bool, limits: KeyLimits) -> KeyEvent
    if limits.kitty_enabled == false
        return KeyUnknownSequence('u')
    let m = mods_with(param(c, 1, 0, 1), alt)
    let motion = kitty_motion(param(c, 1, 1, 1))
    match kitty_press(param(c, 0, 0, 0))
        Some(press) => KeyPressed(KeyStroke { press: press, mods: m, motion: motion })
        None        => KeyUnknownSequence('u')

// Whether the key went down, repeated or came up, from the event type
// the kitty protocol puts after the modifiers.  See the kitty keyboard
// protocol, "Event types".
fn kitty_motion(event: Int) -> keymodel.KeyMotion
    if event == KITTY_RELEASE
        KeyUpEvent
    else if event == KITTY_REPEAT
        KeyRepeatEvent
    else
        KeyDownEvent

// The press a kitty codepoint names.
//
// A codepoint below the private use area is the character the key would
// type with no modifiers, except for the four that have a name.  From
// 57344 upwards it is a functional key, and the protocol's own table
// says which.
fn kitty_press(n: Int) -> ?keymodel.KeyPress
    if n == 0x0D
        Some(KeyNamed(KeyEnter))
    else if n == 0x09
        Some(KeyNamed(KeyTab))
    else if n == ESC
        Some(KeyNamed(KeyEscape))
    else if n == 0x7F
        Some(KeyNamed(KeyBackspace))
    else if n < KITTY_FUNCTIONAL
        Some(KeyChar(n))
    else
        kitty_functional(n)

// The functional keys of the kitty protocol, by their number in the
// private use area.
//
// The numbers this package does not name are the modifier keys
// themselves, the keypad keys that duplicate a named key, and three
// media keys with no variant in `KeyName`.  A sequence carrying one of
// those is reported as unrecognised rather than folded onto a key it is
// not.
fn kitty_functional(n: Int) -> ?keymodel.KeyPress
    if n >= 57358 and n <= 57363
        Some(KeyNamed(kitty_lock_key(n)))
    else if n >= 57376 and n <= 57398
        Some(KeyNamed(KeyFunction(13 + n - 57376)))
    else if n >= 57399 and n <= 57408
        Some(KeyPad(KeyPadDigit(n - 57399)))
    else if n >= 57409 and n <= 57415
        Some(KeyPad(kitty_pad_key(n)))
    else if n == 57427
        Some(KeyPad(KeyPadBegin))
    else
        kitty_media(n)

// The six keys the kitty protocol numbers 57358 to 57363, which are the
// three lock keys, the print screen key, pause and menu.
fn kitty_lock_key(n: Int) -> keymodel.KeyName
    if n == 57358
        KeyCapsLock
    else if n == 57359
        KeyScrollLock
    else if n == 57360
        KeyNumLock
    else if n == 57361
        KeyPrintScreen
    else if n == 57362
        KeyPause
    else
        KeyMenu

// The seven keypad keys the kitty protocol numbers 57409 to 57415,
// which are the decimal point, the four operators, the keypad's own
// Enter and its equals key.
fn kitty_pad_key(n: Int) -> keymodel.KeyPadKey
    if n == 57409
        KeyPadDot
    else if n == 57410
        KeyPadSlash
    else if n == 57411
        KeyPadStar
    else if n == 57412
        KeyPadMinus
    else if n == 57413
        KeyPadPlus
    else if n == 57414
        KeyPadEnter
    else
        KeyPadEqual

// The media and volume keys, which only the kitty protocol reports.
fn kitty_media(n: Int) -> ?keymodel.KeyPress
    if n == 57428
        Some(KeyNamed(KeyMediaPlay))
    else if n == 57429
        Some(KeyNamed(KeyMediaPauseKey))
    else if n == 57432
        Some(KeyNamed(KeyMediaStop))
    else if n == 57435
        Some(KeyNamed(KeyMediaNext))
    else if n == 57436
        Some(KeyNamed(KeyMediaPrev))
    else if n == 57438
        Some(KeyNamed(KeyVolumeDown))
    else if n == 57439
        Some(KeyNamed(KeyVolumeUp))
    else if n == 57440
        Some(KeyNamed(KeyVolumeMute))
    else
        None

// ── a bracketed paste ───────────────────────────────────────────────

// The bytes that close a bracketed paste, which are `CSI 201 ~`.
fn paste_end_marker() -> [u8]
    [ESC as u8, '[' as u8, '2' as u8, '0' as u8, '1' as u8, '~' as u8]

// One byte inside a paste.
//
// A byte that could begin the end marker is held, and the held bytes
// are reported one at a time as soon as another byte proves they were
// pasted text.  The decoder therefore holds at most the five bytes of a
// half-arrived marker, and reports every byte it was given, in order.
fn paste_byte(d: KeyDecoder, b: Int) -> KeyStep
    let h = list.push(d.held, b as u8)
    if starts_marker(h)
        if list.len(h) == list.len(paste_end_marker())
            reporting(d, KeyPasteEnd, false)
        else
            holding(d, h)
    else
        KeyStep { decoder: KeyDecoder { limits: d.limits,
                                        held: list.slice(h, 1, list.len(h)),
                                        in_paste: true },
                  event: Some(KeyPasteByte(byte_at(h, 0))) }

// Whether the bytes are the first bytes of the end marker.
fn starts_marker(h: [u8]) -> Bool
    let marker = paste_end_marker()
    list.len(h) <= list.len(marker) and list.slice(marker, 0, list.len(h)) == h
