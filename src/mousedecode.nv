// mousedecode.nv — a mouse report, and the three encodings a terminal
// might send it in.
//
// X10 is what every terminal has spoken since 1984, and it cannot say
// anything past column 223, because each coordinate is one byte with 32
// added to it.  SGR is what fixed that and is what a program should ask
// for; it is also the only encoding that distinguishes a press from a
// release, because its final byte says which.  urxvt's is a third
// spelling, still sent by rxvt-unicode.  A program decodes whichever
// arrives and works with `MouseReport`.
//
// The button and the modifiers share one byte.  Bits 0 and 1 are the
// button,
// bit 2 is shift, bit 3 is meta, bit 4 is ctrl, bit 5 is motion, bit 6
// means the low two bits are a wheel direction rather than a button,
// and bit 7 means they are one of buttons 8 to 11.  `decode_button` is
// that table written once.  See xterm's `ctlseqs`, "Mouse Tracking".
//
// The coordinates are the terminal's, one-based and column first, as
// they arrive.  tui-nv's buffer is zero-based and converts at that
// boundary, once.
//
// `MouseReport` is a `@value` struct, so it is laid out inline and
// copied at each binding, argument and return (SPEC § 14.4).  Every
// choice on it is an `Int` field with a table of `pub const` names
// beside it, because SPEC § 14.2 admits only scalars, nested `@value`
// structs and fixed-size arrays of those as fields and refuses an enum.

use keymodel

// ── Which spelling a report arrived in ──────────────────────────────
//
// The encoding is on the report because a program that wants to reason
// about what its terminal supports needs to know which one it got, and
// because the X10 ceiling is a limitation a program may want to warn
// about.  A multiplexer re-encoding a click for a child needs it too.

// The encoding of bytes that are not a report.  A refusal is a report
// with this encoding rather than an optional, because an optional
// stores its payload in a heap cell (SPEC § 14.5) and a device build
// has no room for one per mouse event.
pub const MOUSE_NO_ENCODING = 0
// `CSI M <button+32> <col+32> <row+32>`, three raw bytes, and nothing
// past column or row 223 can be said.
pub const MOUSE_X10_ENCODING = 1
// `CSI < <button> ; <col> ; <row> M` for a press and `m` for a release.
// Unbounded coordinates, and the only encoding that distinguishes the
// two.
pub const MOUSE_SGR_ENCODING = 2
// `CSI <button+32> ; <col> ; <row> M`, which is rxvt-unicode's.
// Unbounded coordinates, and a release reported as button 3 exactly as
// in X10, so which button was let go is unknowable.
pub const MOUSE_URXVT_ENCODING = 3

// ── Which button, or which way the wheel turned ─────────────────────
//
// The wheel is a button in every one of the three encodings, which is a
// historical accident rather than a model.  It is decoded into names of
// its own here, so a program that asks for `MOUSE_WHEEL_UP` does not
// have to remember that it is button 64.

// The left button.
pub const MOUSE_LEFT = 1
// The middle button.
pub const MOUSE_MIDDLE = 2
// The right button.
pub const MOUSE_RIGHT = 3
// A motion report with no button held, which only mode 1003 sends, and
// the button of a release the encoding could not name.
pub const MOUSE_NO_BUTTON = 4
// The wheel turned away from the user.
pub const MOUSE_WHEEL_UP = 5
// The wheel turned towards the user.
pub const MOUSE_WHEEL_DOWN = 6
// Horizontal wheel, which a trackpad sends and almost nothing handles.
pub const MOUSE_WHEEL_LEFT = 7
// The horizontal wheel turned right.
pub const MOUSE_WHEEL_RIGHT = 8
// Buttons 8 to 11, which some mice have and xterm reports.  Which one
// is `MouseReport.button_number`.
pub const MOUSE_EXTRA_BUTTON = 9

// ── What happened to the button ─────────────────────────────────────
//
// `MOUSE_RELEASED` is only ever reported with a named button from the
// SGR encoding.  The other two spell a release as button 3, which says
// a button was let go and not which one, so a decoder reports
// `MOUSE_RELEASED` with `MOUSE_NO_BUTTON` and the ambiguity is visible
// in the value rather than hidden by a guess.

// A button went down.
pub const MOUSE_PRESSED = 1
// A button was let go.
pub const MOUSE_RELEASED = 2
// The pointer moved, with or without a button held.
pub const MOUSE_MOVED = 3

// MouseReport is one mouse event, decoded.
pub @value
struct MouseReport
    button: Int
    // Which of buttons 8 to 11, when `button` is `MOUSE_EXTRA_BUTTON`,
    // and zero for every other button.
    button_number: Int
    action: Int
    // Spelled without its module prefix because a module-qualified type
    // name is refused as a `@value` field on this toolchain (novo bug
    // types-values/module-qualified-value-type-refused-as-a-value-field);
    // the `use` line above is what makes the bare name resolve.
    mods: KeyMods
    // One-based, as the terminal reports them.  Column first because
    // that is the order on the wire, and reordering the fields of a
    // struct is how a caller ends up passing them the wrong way round.
    col: Int
    row: Int
    encoding: Int

// The largest coordinate the X10 encoding can express.  A terminal past
// this column sends 223 forever, and a program on a wide screen that
// has not asked for SGR mode is reading a lie.
pub const X10_COORD_MAX = 223

// What X10 adds to the button byte and to each coordinate, so that
// every byte of a report is printable.  It is also what makes 223 the
// ceiling, because 255 is the largest byte there is.
const COORD_OFFSET = 32

// The fields of the button byte, by value rather than by bit number.
const BUTTON_MASK = 3
const BIT_SHIFT = 4
const BIT_META = 8
const BIT_CTRL = 16
const BIT_MOTION = 32
const BIT_WHEEL = 64
const BIT_EXTRA = 128

// no_report is what the three assemblers answer for bytes that are not
// a report.
pub fn no_report() -> MouseReport
    MouseReport { button: MOUSE_NO_BUTTON, button_number: 0,
                  action: MOUSE_MOVED, mods: keymodel.no_mods(), col: 0,
                  row: 0, encoding: MOUSE_NO_ENCODING }

// is_report says whether an assembler read a report out of its
// arguments.
pub fn is_report(r: MouseReport) -> Bool
    r.encoding != MOUSE_NO_ENCODING

// The low two bits of a wheel event, as a direction.
fn wheel_of(low: Int) -> Int
    if low == 0
        MOUSE_WHEEL_UP
    else if low == 1
        MOUSE_WHEEL_DOWN
    else if low == 2
        MOUSE_WHEEL_LEFT
    else
        MOUSE_WHEEL_RIGHT

// The low two bits of a button event, as a button.  Button 3 is the
// release in the two encodings that have no other way to spell one, and
// it names no button.
fn button_of(low: Int) -> Int
    if low == 0
        MOUSE_LEFT
    else if low == 1
        MOUSE_MIDDLE
    else if low == 2
        MOUSE_RIGHT
    else
        MOUSE_NO_BUTTON

// Whether the button byte says a button was let go.  It is button 3
// with neither the wheel bit nor the extra-button bit set, which is how
// X10 and urxvt spell a release.
fn is_release(code: Int) -> Bool
    (code & BIT_WHEEL) == 0 and (code & BIT_EXTRA) == 0 and (code & BUTTON_MASK) == BUTTON_MASK

// The action an X10 or urxvt button byte describes.  Motion is read
// first, because a drag carries the button that is held as well as the
// motion bit.
fn action_of(code: Int) -> Int
    if is_motion(code)
        MOUSE_MOVED
    else if is_release(code)
        MOUSE_RELEASED
    else
        MOUSE_PRESSED

// One report, from a button byte with the X10 offset already taken off.
fn report_of(code: Int, col: Int, row: Int, encoding: Int) -> MouseReport
    MouseReport { button: decode_button(code),
                  button_number: decode_button_number(code),
                  action: action_of(code), mods: decode_mods(code), col: col,
                  row: row, encoding: encoding }

// decode_button reads the button byte's fields.
//
// The one table three encodings share, written once.  The low two bits
// are the button, bit 6 puts them into the wheel's meaning and bit 7
// into buttons 8 to 11.
//
// ```novo
// use mousedecode
//
// fn main() [io]
//     if mousedecode.decode_button(64) == mousedecode.MOUSE_WHEEL_UP
//         println("the wheel turned up")
// ```
pub fn decode_button(code: Int) -> Int
    if (code & BIT_EXTRA) > 0
        MOUSE_EXTRA_BUTTON
    else if (code & BIT_WHEEL) > 0
        wheel_of(code & BUTTON_MASK)
    else
        button_of(code & BUTTON_MASK)

// decode_button_number is which of buttons 8 to 11 a button byte names,
// and zero for a byte that names an ordinary button or the wheel.
//
// It is a second function rather than a payload on the button, because
// a `@value` struct's field is a number and cannot be a variant that
// carries one.
pub fn decode_button_number(code: Int) -> Int
    if (code & BIT_EXTRA) > 0
        8 + (code & BUTTON_MASK)
    else
        0

// decode_mods reads the modifier bits out of the same button byte.
//
// Bit 3 is the one xterm's `ctlseqs` calls meta, and it arrives in
// `meta` under the name the reference gives it.  There is no bit for a
// mouse report's alt.
pub fn decode_mods(code: Int) -> keymodel.KeyMods
    KeyMods { shift: (code & BIT_SHIFT) > 0, alt: false,
              ctrl: (code & BIT_CTRL) > 0, meta: (code & BIT_META) > 0 }

// is_motion says whether the button byte's motion bit is set.
pub fn is_motion(code: Int) -> Bool
    (code & BIT_MOTION) > 0

// button_code is the inverse of `decode_button`, `decode_button_number`
// and `decode_mods` together: the byte a report goes on the wire as,
// before X10 adds its offset.
//
// `number` is which of buttons 8 to 11, and is ignored for every other
// button.
//
// Public for the same reason `keymodel.mods_param` is.  A multiplexer
// forwarding a click to a child, and a test feeding a program a
// synthetic terminal, both need to write what they would have read.
pub fn button_code(button: Int, number: Int, mods: keymodel.KeyMods, motion: Bool) -> Int
    var code = base_code(button, number)
    if mods.shift
        code = code + BIT_SHIFT
    if mods.meta
        code = code + BIT_META
    if mods.ctrl
        code = code + BIT_CTRL
    if motion
        code = code + BIT_MOTION
    code

// The button byte of a button with nothing held.
fn base_code(button: Int, number: Int) -> Int
    if button == MOUSE_LEFT
        0
    else if button == MOUSE_MIDDLE
        1
    else if button == MOUSE_RIGHT
        2
    else if button == MOUSE_WHEEL_UP
        BIT_WHEEL
    else if button == MOUSE_WHEEL_DOWN
        BIT_WHEEL + 1
    else if button == MOUSE_WHEEL_LEFT
        BIT_WHEEL + 2
    else if button == MOUSE_WHEEL_RIGHT
        BIT_WHEEL + 3
    else if button == MOUSE_EXTRA_BUTTON
        BIT_EXTRA + ((number - 8) & BUTTON_MASK)
    else
        3

// report_x10 assembles a report from the three raw bytes that follow
// `CSI M`.
//
// The bytes arrive with 32 added to each, which is why they are three
// raw bytes and not parameters.  A coordinate of 59 is the byte `;`,
// and a parameter scanner would have read it as a separator.  That is
// the case that makes this package's decoder its own state machine.
//
// A byte below 32 is not part of any report and answers `no_report`.
pub fn report_x10(b1: Int, b2: Int, b3: Int) -> MouseReport
    if b1 < COORD_OFFSET or b2 < COORD_OFFSET or b3 < COORD_OFFSET
        return no_report()
    report_of(b1 - COORD_OFFSET, b2 - COORD_OFFSET, b3 - COORD_OFFSET,
              MOUSE_X10_ENCODING)

// report_sgr assembles a report from the SGR encoding's three
// parameters and its final byte.
//
// `final_byte` is `M` for a press and `m` for a release, and it is the
// only place in any of the three encodings where a release says which
// button it was.  Any other final byte answers `no_report`, as does a
// coordinate below one, because SGR coordinates are one-based.
//
// ```novo
// use mousedecode
//
// fn main() [io]
//     // `CSI < 0 ; 40 ; 12 M` — left button pressed at column 40,
//     // row 12.
//     let r = mousedecode.report_sgr(0, 40, 12, 0x4D)
//     if mousedecode.is_report(r) and r.action == mousedecode.MOUSE_PRESSED
//         println("pressed")
// ```
pub fn report_sgr(button_byte: Int, col: Int, row: Int, final_byte: Int) -> MouseReport
    if button_byte < 0 or col < 1 or row < 1
        return no_report()
    if final_byte == 'M'
        report_of(button_byte, col, row, MOUSE_SGR_ENCODING)
    else if final_byte == 'm'
        MouseReport { button: decode_button(button_byte),
                      button_number: decode_button_number(button_byte),
                      action: MOUSE_RELEASED, mods: decode_mods(button_byte),
                      col: col, row: row, encoding: MOUSE_SGR_ENCODING }
    else
        no_report()

// report_urxvt assembles a report from rxvt-unicode's three parameters,
// the first of which carries the same offset X10 adds.
//
// A first parameter below 32 is not a report and answers `no_report`,
// as does a coordinate below one.
pub fn report_urxvt(button_byte: Int, col: Int, row: Int) -> MouseReport
    if button_byte < COORD_OFFSET or col < 1 or row < 1
        return no_report()
    report_of(button_byte - COORD_OFFSET, col, row, MOUSE_URXVT_ENCODING)

// is_wheel says whether a report is a wheel turn rather than a button.
//
// Scrolling is the mouse event most programs handle, and the four
// wheel directions are four of the button names.  This is the question
// a program asks, under a name.
pub fn is_wheel(r: MouseReport) -> Bool
    r.button == MOUSE_WHEEL_UP or r.button == MOUSE_WHEEL_DOWN
        or r.button == MOUSE_WHEEL_LEFT or r.button == MOUSE_WHEEL_RIGHT

// coordinates_are_exact says whether a report's column and row can be
// trusted.
//
// `false` for an X10 report at the 223 ceiling, where the terminal has
// clamped and the true position is unknown.  A program on a wide
// terminal that has not asked for SGR mode needs this to be a question
// it can ask rather than a wrong answer it acts on.  The other two
// encodings send their coordinates as numbers and have no ceiling.
pub fn coordinates_are_exact(r: MouseReport) -> Bool
    if r.encoding == MOUSE_X10_ENCODING
        r.col < X10_COORD_MAX and r.row < X10_COORD_MAX
    else
        true
